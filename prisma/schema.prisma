// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Transaction {
  id               String                   @id @default(uuid())
  name             String
  type             TransactionType
  tipo_transacao   AccountType?
  eh_dedutivel     Boolean                  @default(false)
  amount           Decimal                  @db.Decimal(10, 2)
  category         TransactionCategory
  paymentMethod    TransactionPaymentMethod
  date             DateTime
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  userId           String
  externalId       String?                  @unique
  bankConnectionId String?
  bankConnection   BankConnection?          @relation(fields: [bankConnectionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date])
}

model BankConnection {
  id            String        @id @default(uuid())
  itemId        String        @unique
  connectorName String
  connectorLogo String?
  status        String        @default("UPDATED")
  lastSyncedAt  DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  userId        String
  transactions  Transaction[]
}

model AccountantClient {
  id            String   @id @default(uuid())
  accountantId  String
  clientId      String
  createdAt     DateTime @default(now())

  @@unique([accountantId, clientId])
}

enum AccountType {
  PESSOAL
  EMPRESA
}

enum TransactionType {
  DEPOSIT
  EXPENSE
  INVESTMENT
}

enum TransactionCategory {
  // Pessoal (PF)
  HOUSING
  TRANSPORTATION
  FOOD
  ENTERTAINMENT
  HEALTH
  UTILITY
  SALARY
  EDUCATION
  OTHER
  // Empresa (PJ)
  PRO_LABORE
  FATURAMENTO
  TRIBUTOS
  FORNECEDORES
  EQUIPAMENTOS
  MARKETING
  SERVICOS
  ALUGUEL_EMPRESARIAL
}

enum TransactionPaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  BANK_SLIP
  CASH
  PIX
  OTHER
}
